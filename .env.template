# 4. Add .env to your .gitignore file

# ========================================
# AWS Cognito Configuration
# ========================================
# AWS Cognito User Pool Client ID
AWS_COGNITO_CLIENT_ID=3s2im2cq7m8nb82q41k79rg3v2

# AWS Cognito User Pool Client Secret
AWS_COGNITO_CLIENT_SECRET=10o68m84bvnse7jnccklg98unvncctnm097hijmouor1re7op14m

# AWS Cognito User Pool ID
AWS_COGNITO_USER_POOL_ID=us-east-1_X3grEwPDP

# AWS Region for Cognito services
AWS_COGNITO_REGION=us-east-1

# ========================================
# CORS Configuration
# ========================================
# Allowed origins for CORS (comma-separated)
# For development: include localhost with different ports
# For production: include your actual domain(s)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080,https://yourdomain.com

# Allowed HTTP methods (comma-separated)
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH

# Allowed headers (comma-separated)
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With,Accept,Origin,Access-Control-Request-Method,Access-Control-Request-Headers

# Headers exposed to the client (comma-separated)
CORS_EXPOSED_HEADERS=Access-Control-Allow-Origin,Access-Control-Allow-Credentials

# Allow credentials (cookies, authorization headers)
CORS_ALLOW_CREDENTIALS=true

# Max age for preflight cache (in seconds)
CORS_MAX_AGE=3600

# ========================================
# Rate Limiting Configuration
# ========================================
# Forgot password rate limiting
RATE_LIMIT_FORGOT_PASSWORD_LIMIT=5
RATE_LIMIT_FORGOT_PASSWORD_WINDOW=3600

# Resend confirmation rate limiting
RATE_LIMIT_RESEND_CONFIRMATION_LIMIT=3
RATE_LIMIT_RESEND_CONFIRMATION_WINDOW=3600

# ========================================
# Security Configuration
# ========================================
# Suspicious email patterns (comma-separated regex patterns)
SECURITY_SUSPICIOUS_PATTERNS=.*\\+.*@.*,.*[0-9]{10,}.*@.*

# Disposable email domains to block (comma-separated)
SECURITY_DISPOSABLE_DOMAINS=10minutemail.com,tempmail.org,guerrillamail.com,mailinator.com,throwaway.email,temp-mail.org,yopmail.com,maildrop.cc,tempail.com

# ========================================
# Logging Configuration
# ========================================
# Application log level (TRACE, DEBUG, INFO, WARN, ERROR)
LOG_LEVEL_APP=INFO

# AWS SDK log level
LOG_LEVEL_AWS=WARN

# Authentication logger level
LOG_LEVEL_AUTH=INFO

# Cognito service log level
LOG_LEVEL_COGNITO=INFO

# Controller log level
LOG_LEVEL_CONTROLLER=INFO

# ========================================
# Application Configuration
# ========================================
# Spring profile to activate (local, dev, staging, prod)
SPRING_PROFILES_ACTIVE=local

# Server port (optional, defaults to 8080)
SERVER_PORT=8080

# Database configuration (if applicable)
# DATABASE_URL=jdbc:postgresql://localhost:5432/demo
# DATABASE_USERNAME=demo_user
# DATABASE_PASSWORD=demo_password

# ========================================
# Development/Testing Configuration
# ========================================
# Enable/disable certain features for testing
FEATURE_RATE_LIMITING_ENABLED=true
FEATURE_EMAIL_VALIDATION_ENABLED=true
FEATURE_SECURITY_CHECKS_ENABLED=true

# Test email domain for development
TEST_EMAIL_DOMAIN=example.com

# ========================================
# Production Security Configuration
# ========================================
# JWT secret for custom token signing (if needed)
# JWT_SECRET=your-super-secret-jwt-key-here

# Encryption key for sensitive data
# ENCRYPTION_KEY=your-encryption-key-here

# API keys for external services
# SENDGRID_API_KEY=your-sendgrid-api-key
# TWILIO_API_KEY=your-twilio-api-key

# Monitoring and observability
# NEW_RELIC_LICENSE_KEY=your-newrelic-key
# DATADOG_API_KEY=your-datadog-key

# ========================================
# Infrastructure Configuration
# ========================================
# Redis configuration (for distributed rate limiting)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# Load balancer health check path
# HEALTH_CHECK_PATH=/actuator/health

# ========================================
# Environment-Specific Overrides
# ========================================
# You can override any property based on environment
# Example for staging:
# STAGING_CORS_ALLOWED_ORIGINS=https://staging.yourdomain.com
# STAGING_LOG_LEVEL_APP=DEBUG

# Example for production:
# PROD_CORS_ALLOWED_ORIGINS=https://yourdomain.com
# PROD_LOG_LEVEL_APP=WARN
# PROD_RATE_LIMIT_FORGOT_PASSWORD_LIMIT=3
